# Copy to .env (repo root for the backend, frontend/.env.local for Next) and fill in.
# Keys stay on the server. Never prefix a secret with NEXT_PUBLIC_.

# Backend
USE_FIXTURES=1
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend (Next server side only)
BACKEND_URL=http://127.0.0.1:8000

# ElevenLabs (needed from M8)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
